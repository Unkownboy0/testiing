# Geetorus Core Environment Configuration
NODE_ENV=development
PORT=3100

# Database Configuration (Leave empty to use embedded local PostgreSQL)
# DATABASE_URL=postgres://geetorus_admin:password@localhost:5432/geetorus

# Security & Encryption (Required: 32-byte hex string)
GEETORUS_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Foundation Model Providers (Configure at least one)
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here
OPENAI_API_KEY=sk-proj-your-openai-key-here
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Optional Cloud Execution Sandboxes
# DAYTONA_API_KEY=your-daytona-api-key
# E2B_API_KEY=your-e2b-api-key
